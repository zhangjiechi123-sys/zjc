{
  "name": "steer-by-wire-teaching-sim",
  "version": "1.0.0",
  "description": "汽车线控底盘转向系统教学仿真桌面软件",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 dist-electron/main/main.js && electron .\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite --host 127.0.0.1",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^35.0.0",
    "vite": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
